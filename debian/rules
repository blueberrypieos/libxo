#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

S := $(SRCROOT)/libxo
SOURCES := libxo.c xo_encoder.c xo_syslog.c xo_tolower.c xo_toupper.c xo_utf8.c
OBJS := $(patsubst %.c,$(OBJ)/%.o,$(SOURCES))
DYLIB := $(OBJ)/libxo.dylib
WCWIDTH := $(OBJ)/wcwidth-overlay.json
FLAGS := $(BASE_CFLAGS) -I$(SRCROOT)/debian -I$(S) -DXO_ENCODERDIR=\"/usr/lib/libxo/encoder\" \
	-DXO_SHAREDIR=\"/usr/share/libxo\"

$(OBJ)/%.o: $(S)/%.c debian/xo_config.h
	@mkdir -p $(OBJ)
	$(CC) $(FLAGS) -c $< -o $@

$(WCWIDTH):
	@mkdir -p $(dir $@)
	printf '{"version": 0, "roots": [{"type": "file", "name": "%s", "external-contents": "%s"}]}\n' \
		$(S)/xo_wcwidth.h $(SRCROOT)/debian/xo_wcwidth.h > $@
$(OBJ)/libxo.o: $(WCWIDTH) debian/xo_wcwidth.h
$(OBJ)/libxo.o: FLAGS += -ivfsoverlay $(WCWIDTH)

$(DYLIB): $(OBJS)
	$(CC) $(BASE_LDFLAGS) -dynamiclib -install_name /usr/lib/libxo.dylib \
		-compatibility_version 1 -current_version 1.7.5 $(OBJS) -o $@

XO_MANS := $(filter-out xo_csv.7,$(notdir $(wildcard $(S)/*.[357])))
install: $(DYLIB)
	install -d $(ROOT)/usr/lib $(ROOT)/usr/include/libxo
	install -m 755 $(DYLIB) $(ROOT)/usr/lib/
	install -m 644 $(S)/xo.h $(S)/xo_encoder.h $(ROOT)/usr/include/libxo/
	set -e; for m in $(XO_MANS); do install -d $(ROOT)/usr/share/man/man$${m##*.}; \
		install -m 644 $(S)/$$m $(ROOT)/usr/share/man/man$${m##*.}/; done

.PHONY: install
